---
const { label, labels } = Astro.props as {
  label: string;
  labels: {
    phosphor: string;
    modem: string;
    utilitarian: string;
  };
};

const modes = [
  { value: "phosphor", label: labels.phosphor },
  { value: "modem", label: labels.modem },
  { value: "utilitarian", label: labels.utilitarian },
];
---

<form class="mode-switch" aria-label={label}>
  <fieldset>
    <legend>{label}</legend>
    <div class="mode-switch__options">
      {modes.map((mode) => (
        <label class="mode-switch__option">
          <input type="radio" name="mode" value={mode.value} checked={mode.value === "phosphor"} />
          <span>{mode.label}</span>
        </label>
      ))}
    </div>
  </fieldset>
</form>
<script is:inline>
  (() => {
    const root = document.documentElement;
    const controls = Array.from(document.querySelectorAll('input[name="mode"]'));
    const allowed = new Set(["phosphor", "modem", "utilitarian"]);
    const storageKey = "theme-mode";
    const legacyKey = "interaction-mode";

    function applyMode(mode) {
      if (!allowed.has(mode)) return;
      root.dataset.mode = mode;
      const plainCss = document.getElementById("plain-theme-css");
      if (plainCss) {
        plainCss.disabled = mode !== "utilitarian";
      }
      for (const control of controls) {
        control.checked = control.value === mode;
      }
      try {
        localStorage.setItem(storageKey, mode);
      } catch {
        // Preference persistence is optional progressive enhancement.
      }
    }

    try {
      const stored = localStorage.getItem(storageKey) || localStorage.getItem(legacyKey);
      if (stored) applyMode(stored);
    } catch {
      // The form still works for the current page session.
    }

    for (const control of controls) {
      control.addEventListener("change", () => applyMode(control.value));
    }
  })();
</script>
