---
import TuiPanel from "./TuiPanel.astro";
import SixelBuggy from "./SixelBuggy.astro";

type BuildRunBlock = {
  heading: string;
  intro?: string;
  commands: string[];
};

type Project = {
  title: string;
  summary: string;
  repoUrl: string;
  repoLabel: string;
  status: string;
  prerequisites: string[];
  sections: BuildRunBlock[];
};

const { project, heading, intro, prerequisitesHeading, sixelHeading } = Astro.props as {
  project: Project;
  heading?: string;
  intro?: string;
  prerequisitesHeading: string;
  sixelHeading?: string;
};
---

<TuiPanel title={heading ?? project.title}>
  <article class="project-block">
    <h1>{heading ?? project.title}</h1>
    <p class="project-meta"><strong>{project.status}</strong> · <a href={project.repoUrl}>{project.repoLabel}</a></p>
    <p>{intro ?? project.summary}</p>

    <SixelBuggy
      title={sixelHeading ?? "banners"}
      banners={[
        {
          src: "/media/arclength/github-readme.png",
          alt: "ArclengthContinuation README hero banner",
          caption: "github-readme.png 2176x544",
        },
        {
          src: "/media/arclength/readme.png",
          alt: "ArclengthContinuation wordmark banner",
          caption: "readme.png 1500x500",
        },
      ]}
    />

    <h2>{prerequisitesHeading}</h2>
    <ul class="prereq-list">
      {project.prerequisites.map((item) => (
        <li>{item}</li>
      ))}
    </ul>

    {project.sections.map((section) => (
      <section>
        <h2>{section.heading}</h2>
        {section.intro && <p>{section.intro}</p>}
        <pre><code>{section.commands.join("\n")}</code></pre>
      </section>
    ))}
  </article>
</TuiPanel>
