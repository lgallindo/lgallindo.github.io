---
interface Props {
  locale: string;
  title: string;
  blurb: string;
  promptLabel: string;
}

const { title, blurb, promptLabel } = Astro.props;
---

<section class="tui-panel alc-sandbox-panel" aria-labelledby="alc-sandbox-heading">
  <h1 id="alc-sandbox-heading">{title}</h1>
  <p>{blurb}</p>
  <p class="alc-sandbox__hint"><code>{promptLabel}</code></p>
  <div class="alc-sandbox" data-alc-sandbox tabindex="0" role="application" aria-label={title}></div>
</section>

<style is:global>
  .alc-sandbox-panel .alc-sandbox {
    min-height: 16rem;
    padding: 0.5rem;
    border: 1px solid var(--color-panel-border);
    background: #000000;
  }

  .alc-sandbox .xterm {
    height: 14rem;
  }

  .alc-sandbox__hint {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
</style>

<script>
  import { Terminal } from "@xterm/xterm";
  import { FitAddon } from "@xterm/addon-fit";
  import "@xterm/xterm/css/xterm.css";

  const DENY =
    /\b(curl|wget|rm|sudo|chmod|chown|ssh|nc|ncat|bash|sh|python|node)\b|[;|`]|\$\(|\.\.\//;

  const RESPONSES: Record<string, string> = {
    help: [
      "Arclength sandbox (scripted; no real binary).",
      "Commands: help | version | alc --help | clear",
      "Anything else is rejected.",
    ].join("\r\n"),
    version: "arclength-sandbox 0.0.1-demo (UI only)",
    "alc --help": [
      "alc — ArclengthContinuation CLI (demo stub)",
      "",
      "Usage: alc [command]",
      "",
      "This Pages sandbox does not execute the real CLI.",
      "Build locally: see Home → Run.",
    ].join("\r\n"),
  };

  function normalize(line: string): string {
    return line.trim().replace(/\s+/g, " ").toLowerCase();
  }

  function replyFor(line: string): string {
    const key = normalize(line);
    if (!key) return "";
    if (DENY.test(key) || DENY.test(line)) {
      return "denied: command blocked in restricted sandbox";
    }
    if (key === "clear") return "__CLEAR__";
    if (RESPONSES[key]) return RESPONSES[key];
    return `denied: unknown command '${line.trim()}' (try: help)`;
  }

  function mount(el: HTMLElement) {
    if (el.dataset.mounted === "1") return;
    el.dataset.mounted = "1";

    const term = new Terminal({
      cursorBlink: true,
      fontFamily: "IBM Plex Mono, ui-monospace, monospace",
      fontSize: 14,
      theme: {
        background: "#000000",
        foreground: "#00ff66",
        cursor: "#00ff66",
      },
      convertEol: true,
    });
    const fit = new FitAddon();
    term.loadAddon(fit);
    term.open(el);
    fit.fit();

    const prompt = "alc$ ";
    let buffer = "";

    const writePrompt = () => {
      term.write(`\r\n${prompt}`);
    };

    term.writeln("ArclengthContinuation restricted sandbox");
    term.writeln("Type help. No network. No real binary.");
    writePrompt();

    term.onData((data) => {
      const code = data.charCodeAt(0);
      if (data === "\r") {
        term.write("\r\n");
        const out = replyFor(buffer);
        buffer = "";
        if (out === "__CLEAR__") {
          term.clear();
          writePrompt();
          return;
        }
        if (out) term.writeln(out);
        writePrompt();
        return;
      }
      if (code === 127) {
        if (buffer.length > 0) {
          buffer = buffer.slice(0, -1);
          term.write("\b \b");
        }
        return;
      }
      if (code < 32) return;
      buffer += data;
      term.write(data);
    });

    window.addEventListener("resize", () => fit.fit());
  }

  document.querySelectorAll<HTMLElement>("[data-alc-sandbox]").forEach(mount);
</script>
