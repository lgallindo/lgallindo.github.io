---
import StatusLine from "../components/navigation/StatusLine.astro";
import "../styles/global.css";
import { publicLocales, localizedPath, type PublicLocaleCode } from "../i18n/locales";
import { publicCopy } from "../content/site";

const {
  locale,
  title,
  description,
  nav,
  listed = true,
} = Astro.props as {
  locale: PublicLocaleCode;
  title: string;
  description: string;
  nav: { label: string; href: string }[];
  listed?: boolean;
};

const copy = publicCopy[locale];
const pathWithoutLocale = Astro.url.pathname.replace(/^\/(en_US|pt_BR)(?=\/|$)/, "") || "/";
---

<!doctype html>
<html lang={locale.replace("_", "-")} data-mode="phosphor">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {listed && publicLocales.map((code) => (
      <link rel="alternate" hreflang={code.replace("_", "-")} href={new URL(localizedPath(code, pathWithoutLocale), Astro.site)} />
    ))}
    {listed && <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site)} />}
    <link id="plain-theme-css" rel="stylesheet" href="/vendor/simple.min.css" disabled />
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.shell.skipToMain}</a>
    <StatusLine
      locale={locale}
      nav={nav}
      listed={listed}
      primaryLabel={copy.shell.primaryNavLabel}
      languageLabel={copy.shell.languageNavLabel}
      modeLabel={copy.shell.modeLabel}
      modes={copy.modes}
    />
    <main id="main" class="shell-main">
      <slot />
    </main>
    <!-- SVG filter referenced by buggy sixel CSS; kept out of layout flow. -->
    <svg class="visually-hidden" width="0" height="0" aria-hidden="true" focusable="false">
      <filter id="sixel-posterize" color-interpolation-filters="sRGB">
        <feComponentTransfer>
          <feFuncR type="discrete" tableValues="0 0.2 0.4 0.6 0.8 1"></feFuncR>
          <feFuncG type="discrete" tableValues="0 0.2 0.4 0.6 0.8 1"></feFuncG>
          <feFuncB type="discrete" tableValues="0 0.25 0.5 0.75 1"></feFuncB>
        </feComponentTransfer>
      </filter>
    </svg>
  </body>
</html>
