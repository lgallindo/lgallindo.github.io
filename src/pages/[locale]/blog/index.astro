---
import TerminalShell from "../../../layouts/TerminalShell.astro";
import TuiPanel from "../../../components/chrome/TuiPanel.astro";
import { publicCopy } from "../../../content/site";
import { publicLocales, type PublicLocaleCode } from "../../../i18n/locales";

export function getStaticPaths() {
  return publicLocales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as PublicLocaleCode;
const copy = publicCopy[locale];
---

<TerminalShell locale={locale} title={`${copy.blog.heading} | ${copy.title}`} description={copy.description} eyebrow={copy.eyebrow} nav={copy.nav}>
  <TuiPanel title={copy.blog.heading}>
    <h1>{copy.blog.heading}</h1>
    <p>{copy.blog.intro}</p>
    <ol class="record-list">
      {copy.blog.posts.map((post) => (
        <li>
          <article>
            <h2>{post.title}</h2>
            <p><time datetime={post.date}>{post.date}</time></p>
            <p>{post.summary}</p>
          </article>
        </li>
      ))}
    </ol>
  </TuiPanel>
</TerminalShell>
