---
import TerminalShell from "../../layouts/TerminalShell.astro";
import ProjectBuildRun from "../../components/chrome/ProjectBuildRun.astro";
import { publicCopy } from "../../content/site";
import { publicLocales, type PublicLocaleCode } from "../../i18n/locales";

export function getStaticPaths() {
  return publicLocales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as PublicLocaleCode;
const copy = publicCopy[locale];
const project = copy.projects.items[0];
---

<TerminalShell locale={locale} title={copy.title} description={copy.description} nav={copy.nav}>
  <ProjectBuildRun
    project={project}
    heading={project.title}
    intro={copy.home.intro}
    prerequisitesHeading={copy.projects.prerequisitesHeading}
  />
</TerminalShell>
